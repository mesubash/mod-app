.DS_Store

# --- Never commit: user data --------------------------------------------
# Probe traces are identifiable location data. A public repository is the
# worst place for them, and a leak is not undone by deleting the file later.
# See docs/product.md on aggregating before persisting.
probes/
traces/
sessions/
*.gpx
*.trace
data/probes*
data/sessions*
data/users*

# --- Never commit: secrets -----------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# --- Never commit: database ----------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
pgdata/

# --- Build products -------------------------------------------------------
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
node_modules/
web/dist/
web/.vite/
web/.output/
web/.tanstack/
web/.nitro/

# --- Working standards, not repo content ---------------------------------
# Binding for anyone building here, but kept out of the public repository the
# same way they are in the research repo. Hand them to a collaborator or an
# agent directly.
AI-GUARDRAILS.md
UI-PROMPT.md
UI-PROMPT-MOBILE.md

# --- Local only -----------------------------------------------------------
.idea/
.vscode/
*.local

AGENTS.md
CLAUDE.md

# Review notes, kept local
reviews/

# Copy to .env and fill in what you need. Docker Compose reads .env on its
# own; for the API on its own, run
#   uv run --env-file .env uvicorn api.main:app --reload
#
# Optional settings are commented out: an empty value is not the same as an
# unset one, so leave a line commented unless you mean to set it.

# Required to post or clear closures from the operator console.
MOD_OPERATOR_TOKEN=

# Allowed cross-origin callers, comma-separated. Unset allows the local web
# dev server; set to empty to allow none.
# MOD_CORS_ORIGINS=https://mod.example.org

# SQLite file. Unset uses data/mod.db. Docker Compose sets its own.
# MOD_DB=/var/lib/mod/mod.db

# Place search via Baato. Unset, /places/search returns configured:false and
# the app uses its fixed corridor place list.
# BAATO_API_KEY=

# Copy to .env and fill in what you need. Compose reads this automatically;
# for a plain `uv run uvicorn` run, export these in the shell instead.

# Allowed cross-origin callers. Empty allows none; unset defaults to the
# local dev server origins. See README.md.
MOD_CORS_ORIGINS=

# Required to post or clear closures from the operator console.
MOD_OPERATOR_TOKEN=

# Place search via Baato. Unset, /places/search returns configured:false and
# the app falls back to its fixed corridor place list -- nothing else
# depends on this being set.
BAATO_API_KEY=
